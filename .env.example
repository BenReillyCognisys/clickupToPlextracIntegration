PORT=4000

# ── ClickUp ──────────────────────────────────────────────────────────────────
# Personal API token (ClickUp → Settings → Apps → API Token)
CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxx

# Workspace/team ID (visible in the URL: app.clickup.com/{team_id}/...)
CLICKUP_TEAM_ID=

# Space ID for "Penetration Testing" — find it by running: node scripts/list-spaces.js
CLICKUP_SPACE_ID=

# Webhook signing secret — set this after running: node scripts/register-webhook.js
CLICKUP_WEBHOOK_SECRET=

# ── SecOps space → VMaaS folder ──────────────────────────────────────────────
# A second webhook (scripts/register-secops-webhook.js) listens to the SecOps
# space and drives the VMaaS pipeline: a task created in the VMaaS folder is named
# after the client, and its authorisation form is generated with the testing type
# "VMaaS" (see pipeline/vmaas.js). ClickUp can only scope a webhook to a whole
# space, so SecOps events outside the VMaaS folder arrive here and are filtered out
# by CLICKUP_VMAAS_FOLDER_ID — leave that blank and the whole SecOps space is
# ignored. Lists whose name contains "template" are skipped either way.
CLICKUP_SECOPS_SPACE_ID=90150758482
CLICKUP_VMAAS_FOLDER_ID=901517065720

# Signing secret for the SecOps webhook — printed by
# node scripts/register-secops-webhook.js. Separate from CLICKUP_WEBHOOK_SECRET
# above (ClickUp issues one secret per webhook); the endpoint accepts either.
CLICKUP_WEBHOOK_SECRET_SECOPS=

# Public URL of this server (no trailing slash)
WEBHOOK_URL=https://api.break.services

# ── Scheduling (/schedule/pentest) ───────────────────────────────────────────
# Backs the POST /schedule/pentest endpoint, which creates a ClickUp engagement
# task from a chosen consultant + date range. A background job refreshes the
# consultant-availability and service-types cache every CLICKUP_REFRESH_INTERVAL_MS.

# Shared secret required in the X-API-Key header on the scheduling endpoints, on the
# /jobs/* manual triggers, and on the /tasks/* repair endpoints (GET /tasks/:taskId,
# POST /tasks/replay, POST /tasks/remap — see docs/task-admin.md). No extra config:
# replay re-runs a missed taskCreated for a task id, remap moves a report's
# automations onto a different ClickUp task.
AVAILABILITY_API_KEY=

# Shared secret required in the X-API-Key header on the SFE-portal action endpoints
# (POST /clickup/merged-auth-form, /clickup/extra-urls, /clickup/schedule-task).
# Usually the same value as AVAILABILITY_API_KEY above. The SAME secret also
# authenticates the reverse call — break.services → portal — that generates a
# client auth form on task creation (see SECURE_PORTAL_URL below).
BREAK_SERVICES_API_KEY=

# ── Secure portal (SFE) — auth-form generation ───────────────────────────────
# When a ClickUp delivery task is created (every testing type), the create pipeline
# calls the portal to generate that client's authorisation form and comments the
# returned link back onto the task. Set this to the portal's base URL (no trailing
# slash); break.services POSTs to {SECURE_PORTAL_URL}/api/clickup/auth-form with the
# X-API-Key header (BREAK_SERVICES_API_KEY above). Leave blank to disable the step
# (the report is still created; a warning is logged and no form is generated).
# Renaming the task later (e.g. "Black Box" → "External") POSTs to
# {SECURE_PORTAL_URL}/api/clickup/auth-form/update so the portal can swap the old
# testing type's element out of the form for the new one — see docs/auth-form-rename.md.
SECURE_PORTAL_URL=https://portal.example
# Optional outbound timeout in ms (default 15000).
#SECURE_PORTAL_TIMEOUT_MS=15000
# ClickUp custom field the generated auth-form link is written to. Defaults to
# "authformlink"; override if the field is named differently in your space.
#CLICKUP_AUTH_FORM_FIELD_NAME=authformlink
# File-type ClickUp custom field the FINALISED (signed) auth form is uploaded to by
# POST /clickup/finalised-auth-form. Defaults to "Authorisation Forms"; override if
# the field is named differently. (Distinct from the link field above.)
#CLICKUP_AUTH_FORM_FILE_FIELD_NAME=Authorisation Forms
# Date-type ClickUp custom field the client's chosen report deadline (`reportDeadline`
# on POST /clickup/schedule-task) is written to. Defaults to "Report Due", which every
# task in the pentest space carries. When a task doesn't have it, the deadline is added
# as a comment instead, so a rename here is a tidiness fix, not an outage.
#CLICKUP_REPORT_DUE_FIELD_NAME=Report Due
# The two test-files fields. They sound alike and are NOT the same field:
#  * the LINK field (short_text) holds the client's per-task upload link, written by
#    the create pipeline from what the portal returns with the auth form.
#  * the COMPLETION BOX (checkbox, or a checklist item) is ticked by
#    POST /clickup/test-files-uploaded once the client has uploaded. ClickUp won't
#    take two fields of the same name on a list, so the box is "testfilesstored".
# The box name is a comma-separated list of accepted names, tried in order, so a
# rename (or the original "testfilesstorage" naming) resolves without a code change.
#CLICKUP_TEST_FILES_LINK_FIELD_NAME=testfilesstorage
#CLICKUP_TEST_FILES_DONE_FIELD_NAME=testfilesstored,testfilesstorage

# The /clickup/extra-urls endpoint alerts SLACK_AUTH_FORM_CHANNEL (defined further
# below) when a Free Black Box form scopes more than one URL. No extra config here.

# Comma-separated CORS allowlist for the browser-facing scheduling endpoints
# (GET /availability/pentest, POST /schedule/pentest). Leave blank to reflect
# any origin (matches the sfe-portal's previous behaviour); set to the exact
# frontend origin(s) to lock it down, e.g. https://app.example.com
SCHEDULING_ALLOWED_ORIGINS=

# Team view whose sidebar lists the bookable consultants (the "roster")
CLICKUP_VIEW_ID=

# ClickUp Doc holding the Service Type → Independent consultants table
CLICKUP_SERVICE_TYPES_DOC_ID=
CLICKUP_SERVICE_TYPES_PAGE_ID=

# Internal-audit roster (GET /availability/internalaudit) = the people pinned in
# the sidebar of this ClickUp view — same mechanism as CLICKUP_VIEW_ID above, just
# a different view. No service-type/skill filtering: availability is searched purely
# on day count across those people. This is the view id from the URL
# app.clickup.com/{team}/v/wl/{viewId}. Defaults to the known view id if unset.
#CLICKUP_INTERNAL_AUDIT_VIEW_ID=6-901507566408-18

# List that new engagement tasks are created in, and its numeric custom fields
CLICKUP_ENGAGEMENT_LIST_ID=
CLICKUP_DAYS_FIELD_NAME=Days Balance
CLICKUP_REVENUE_FIELD_NAME=R

# Custom field(s) holding a task's effort in days (e.g. 0.5 = half day), used by
# GET /availability/freeblackbox to compute half-day gaps. Comma-separated, tried
# in order; the first one present on a task wins. Defaults to "Days, Days Balance".
#CLICKUP_LOAD_FIELD_NAMES=Days, Days Balance
# Optional status to set on newly created engagement tasks
#CLICKUP_DEFAULT_STATUS=

# Optional cache tuning (defaults shown)
#CLICKUP_TIMEZONE=Europe/London
#CLICKUP_WEEKS=4
#CLICKUP_INCLUDE_CLOSED=false
#CLICKUP_REFRESH_INTERVAL_MS=120000
# JSON {id:name} fallback roster used only if the view sidebar has no assignees
#CLICKUP_ROSTER_FALLBACK={}

# ── Plextrac ─────────────────────────────────────────────────────────────────
# Plextrac instance hostname (no https://)
PLEXTRAC_INSTANCE=cognisys.plextrac.com

# Service-account credentials — used to obtain a JWT on startup (auto-refreshed)
PLEXTRAC_USERNAME=
PLEXTRAC_PASSWORD=

# Template and layout names to use when creating reports (must match exactly in Plextrac)
PLEXTRAC_REPORT_TEMPLATE=Cognisys Web Application Black Box
PLEXTRAC_FINDINGS_LAYOUT=Pentest Cognisys

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Connection string from Atlas → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=clickup_plextrac

# ── Plextrac → ClickUp status mapping ────────────────────────────────────────
# Plextrac webhook secret (set when configuring the webhook in Plextrac)
PLEXTRAC_WEBHOOK_SECRET=

# ClickUp status to set when a Plextrac report moves to "Ready For Review"
CLICKUP_STATUS_QA=QA / Reviewing

# ClickUp status to set when a Plextrac report is Published
CLICKUP_STATUS_COMPLETE=Completed

# Status a task moves to once POST /clickup/finalised-auth-form has attached the
# signed authorisation form — the paperwork is done and only the client's pre-reqs
# are outstanding. Must match a status in the pentest space exactly (case included);
# list them with: node scripts/list-statuses.js
CLICKUP_STATUS_PRE_REQS=Waiting for Pre-reqs

# Only tasks currently in one of these statuses are advanced to CLICKUP_STATUS_PRE_REQS.
# A finalised form can arrive late, or be re-sent for a client whose other tasks are
# already under way, and a task in QA must not be dragged back to pre-reqs. Comma
# separated, matched case-insensitively; leave blank for the defaults shown.
CLICKUP_PRE_REQS_FROM_STATUSES=to do,open,scheduled

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Bot token (xoxb-...) with the chat:write scope, used to post the threaded
# first-round-QA messages (incoming webhooks can't thread). The bot must be a
# member of the #pt-first-round-qa channel.
SLACK_BOT_TOKEN=
# Channel id for #pt-first-round-qa (from the channel URL: .../archives/<id>)
SLACK_FIRST_ROUND_QA_CHANNEL=C0B9D6487HR
# Channel id for #pt-second-round-qa — the "ready for second round of QA" announcement
# is posted here when a report reaches PLEXTRAC_QA_SECOND_STATUS. The bot must be a member.
SLACK_SECOND_ROUND_QA_CHANNEL=C09GDNG20JF
# Slack user ids @-mentioned on that second-round announcement (the second-round QA
# reviewers), comma/space-separated. Blank = the built-in list in pipeline/qa-second-round.js.
SLACK_SECOND_ROUND_QA_MENTIONS=
# Channel for the "report released" announcement, posted when a report reaches
# PLEXTRAC_RELEASED_STATUS. Defaults to the second-round channel; override if it differs.
SLACK_RELEASED_QA_CHANNEL=C09GDNG20JF
# Slack user ids @-mentioned on the release announcement, comma/space-separated.
# Blank = the built-in list in pipeline/qa-released.js.
SLACK_RELEASED_QA_MENTIONS=

# ── Slack slash commands (/reportqueue, /reportqueueall, /report-kpis) ─────────
# All three POST to /slack/commands. /reportqueue + /reportqueueall render the QA
# queue (reports in first-/second-round QA, maintained by the Plextrac webhook):
# /reportqueue replies ephemerally; /reportqueueall posts to the channel and is
# restricted to PMs. /report-kpis replies ephemerally with a leaderboard of how many
# QAs each consultant has performed (see the "QA KPIs" section further down).
#
# Slack app Signing Secret (Basic Information → App Credentials) — verifies that
# requests genuinely come from Slack. Required for the slash commands to work.
SLACK_SIGNING_SECRET=
# Comma-separated Slack user IDs allowed to run /reportqueueall (the PMs). Find a
# user's ID via their Slack profile → "Copy member ID" (looks like U012ABC). If left
# blank, a default PM allowlist baked into routes/slack-command.js is used instead.
SLACK_PM_USER_IDS=
# Plextrac statuses that define the two QA rounds and the "released" state. Defaults
# shown; override only if your Plextrac workflow uses different status names.
#PLEXTRAC_QA_FIRST_STATUS=Ready For Review
#PLEXTRAC_QA_SECOND_STATUS=In Review
#PLEXTRAC_RELEASED_STATUS=Published
# One-shot backfill: POST /jobs/qa-queue-seed (X-API-Key) scans the whole Plextrac
# tenant and seeds any report already in a QA stage. QA_SEED_CONCURRENCY (default 5)
# caps how many reports are fetched in parallel.
#QA_SEED_CONCURRENCY=5

# ── QA KPIs (/report-kpis) ────────────────────────────────────────────────────
# The Plextrac webhook records who (the payload's actorCuid) moves each report
# through the QA workflow; /report-kpis aggregates that into a per-consultant
# leaderboard. Anti-abuse: a consultant is credited AT MOST ONCE per report, no
# matter how many times they change its status, and the initial "Ready For Review"
# (an author submitting their OWN report for QA) is never counted.
#
# Comma-separated report statuses that do NOT earn a QA credit. Defaults to the
# initial submit status (PLEXTRAC_QA_FIRST_STATUS / "Ready For Review"). Add more
# here to exclude them too, e.g. "Ready For Review,Ready for Release".
#PLEXTRAC_KPI_EXCLUDED_STATUSES=Ready For Review
#
# Consultant identity comes from enumerating Plextrac users and matching each
# actorCuid on the user's `cuid` field (Plextrac's user lookup is by id, not cuid).
# Path to the tenant users endpoint — override only if your instance differs (use
# the literal {tenantId} token). Confirm the path/shape with:
#   node scripts/inspect-users.js
#PLEXTRAC_USERS_PATH=/api/v1/tenant/{tenantId}/user/list
# How long (ms) to cache the enumerated user list. Default 10 minutes.
#PLEXTRAC_USERS_CACHE_MS=600000
#
# Report-submission lateness (shown only in /report-kpis @user). When a report is
# first submitted for QA (its author moves it to the submit status below), we compare
# the submission time to the report's ClickUp due date. The due day is never counted
# late — the clock starts at KPI_LATE_START_HOUR on the NEXT WORKING DAY (so a report
# due Thursday starts Friday 09:00; due Friday starts Monday 09:00). Only mapped
# reports are tracked (a ClickUp task is needed for the due date).
# The status that means "author submitted for QA" (defaults to the initial
# "Ready For Review" / PLEXTRAC_QA_FIRST_STATUS).
#PLEXTRAC_SUBMIT_STATUS=Ready For Review
# Hour (0–23, local to KPI_LATE_TZ) the lateness clock starts on the next working day.
#KPI_LATE_START_HOUR=9
# Timezone for the day/next-working-day/09:00 math (defaults to REPORTS_DUE_TZ, then
# Europe/London).
#KPI_LATE_TZ=Europe/London

# ── Daily auth-form check (Penetration Test space) ────────────────────────────
# Runs daily at 14:00 and can be triggered manually via POST /jobs/auth-form-check.
# Scans the Penetration Test space (CLICKUP_SPACE_ID) for tasks with the
# "Pre Recs Received?" checkbox ticked but "Tester OKd Pre-Recs" NOT yet ticked
# and at least one assignee (all such tasks are chased, regardless of start date).
# It then posts ONE message to the qa-chat channel @-mentioning the assigned users,
# grouped under their start date.
#
# Every 5 minutes after that, a reconcile re-scans the space and strikes through
# any listed task that's since been actioned (Tester OKd Pre-Recs ticked, or the
# task closed), editing the same message in place. Trigger it manually via POST
# /jobs/auth-form-reconcile. Editing the message needs the bot's `chat:write` scope.
#
# Channel the bot posts to (it must be a member). Use the channel ID, not the
# name — chat.postMessage returns channel_not_found for names like "#qa-chat-".
# Get the ID from the channel's "About" popup or its URL (.../archives/C0123ABCD).
# Mentions also require the bot token to have the `users:read.email` scope (to
# resolve ClickUp emails → Slack ids).
SLACK_AUTH_FORM_CHANNEL=C0123ABCD
# Optional overrides for the schedules (standard cron) and timezone. Both default to
# working days only (Mon–Fri) so nothing is posted at the weekend.
#AUTH_FORM_CHECK_CRON=0 14 * * 1-5
#AUTH_FORM_RECONCILE_CRON=*/5 * * * 1-5
#AUTH_FORM_CHECK_TZ=Europe/London

# ── Weekly reports-due check (Pentesting space) ───────────────────────────────
# Scans the Pentesting space (CLICKUP_SPACE_ID) and, for each task, computes the
# report deadline as the task's due date + REPORTS_DUE_SLA_DAYS business days (3).
# Posts ONE Slack message listing deadlines missed (within the last
# REPORTS_DUE_MISSED_LOOKBACK_DAYS days) and those landing Mon–Fri this week,
# grouped by day. Trigger manually with POST /jobs/reports-due.
#
# When a listed report later moves into a done status (REPORTS_DUE_DONE_STATUSES,
# default "Completed" + "Ready For Release") it's struck through and the original
# message edited in place. Two triggers drive this:
#   • Plextrac webhook (POST /webhook/plextrac) — when a report is Published it syncs
#     ClickUp to "Completed" and crosses it off. Always available (no extra config).
#   • ClickUp webhook (POST /webhook/clickup) — a taskStatusUpdated event crosses off
#     any done status, incl. "Ready For Release" (which Plextrac never emits). Needs
#     the ClickUp webhook subscription to include the taskStatusUpdated event.
# The cross-off is idempotent, so both firing for the same report is harmless.
#
# Channel the report is posted to (the bot must be a member). Channel ID, not name.
SLACK_REPORTS_DUE_CHANNEL=C091H6MLS6A
# Runs Mondays at 06:00 by default. Override the schedule here, or set it blank
# (REPORTS_DUE_CRON=) to disable the cron and run manually only.
#REPORTS_DUE_CRON=0 6 * * 1
#REPORTS_DUE_TZ=Europe/London
#REPORTS_DUE_SLA_DAYS=3
#REPORTS_DUE_MISSED_LOOKBACK_DAYS=14
#REPORTS_DUE_SHOW_MISSED_SLA=true
# Comma-separated ClickUp statuses that cross a report off the posted message.
#REPORTS_DUE_DONE_STATUSES=Completed,Ready For Release

# ── Start-date watcher ────────────────────────────────────────────────────────
# Reports are created as soon as their ClickUp task appears, even with no start
# date — the name then falls back to the current month/year. This watcher re-checks
# those tasks and renames the report once a start date is set. Runs every 8 hours
# by default; override the schedule here, or set it blank (START_DATE_WATCH_CRON=)
# to disable the cron and run manually via POST /jobs/start-date-watch.
#START_DATE_WATCH_CRON=0 */8 * * *
#START_DATE_WATCH_TZ=Europe/London

# ── AI QA Review (Plextrac "ready for QA" webhook) ────────────────────────────
# Claude API key — get one at console.anthropic.com. NOTE: a Claude Pro/Max
# subscription does NOT work here; server-side calls require a billed API key.
ANTHROPIC_API_KEY=sk-ant-...
# Model (default: claude-haiku-4-5 — cheapest; ~5x less than Opus). Raise to
# claude-sonnet-4-6 or claude-opus-4-8 only if you need higher edit quality.
#ANTHROPIC_MODEL=claude-haiku-4-5
# Cost controls for the AI checks:
#QA_AI_THINKING=false      # extended thinking off by default (thinking tokens bill as output)
#QA_AI_EFFORT=             # leave blank; only set on Opus/Sonnet (errors on Haiku)
#QA_AI_MAX_TOKENS=4000     # output cap per call

# The QA review runs from the existing /webhook/plextrac handler (no separate
# webhook needed). This is the report status that triggers it — it must match the
# status Plextrac sets when a report is ready for QA.
PLEXTRAC_QA_STATUS=Ready For Review

# Dedicated Slack channel for QA change reports (falls back to SLACK_WEBHOOK_URL)
QA_SLACK_WEBHOOK_URL=

# Append-only audit log file (every change is written here as well as to Slack)
LOG_FILE=./logs/qa-review.log

# Per-check toggles — set to "false" to disable an individual check
#QA_CHECK_STRIP_FORMATTING=true   # NOTE: currently PAUSED in code (being redefined)
#QA_CHECK_CLIENT_NAME=true
#QA_CHECK_DEJARGON=true
#QA_CHECK_SENTENCES=true

# Report custom fields (Team Name, Author 1, Author 1 Title, Author 1 Email, ...)
# are checked for being empty at EVERY QA round (first round, second round and
# release); any empty one is listed in that round's Slack thread and @-mentions the
# person who moved the report into that round (submitted it / passed it on /
# released it) so they can fill it in. These labels
# are EXEMPT from that check (they don't need to be filled in). Matching is on the
# exact label, case- and whitespace-insensitive. Comma-separated; defaults to
# Client Acronym, Client Full Name, Report Title and Version.
#QA_OPTIONAL_REPORT_FIELDS=Client Acronym,Client Full Name,Report Title,Version

# Safety cap on how many findings to process per report
#QA_MAX_FINDINGS=200

# Organisation names the client-name check must NEVER change (the testing
# provider is not the client). Comma-separated; defaults to the Cognisys variants.
#QA_PROTECTED_NAMES=Cognisys Group Limited,Cognisys Group,Cognisys

# Executive-summary section names that get a REDUCED review: the client-name
# check still runs (the client name must be right everywhere) but de-jargon and
# incomplete-sentence checks are skipped. These are templated/boilerplate sections,
# not narrative. Matching is case-insensitive and substring-based against the
# section label/title. Comma-separated; defaults to Methodology, Issue Matrix and
# Limitations.
#QA_EXCLUDED_SECTIONS=Methodology,Issue Matrix,Limitations

# ── Plextrac change tracking ──────────────────────────────────────────────────
# Toggles the report's `isTrackChanges` field on before edits and off afterwards
# (via the report update endpoint). ON by default — set to false to opt out (the
# internal audit log in LOG_FILE + Slack records every change regardless).
#PLEXTRAC_CHANGE_TRACKING_ENABLED=true

# ── Google service account (Drive access) ─────────────────────────────────────
# Path to the Google service-account JSON key. Defaults to the production path
# /var/app/api/sfe-app-gdrive-integration-1780a21efebe.json when unset. Used by
# POST /clickup/finalised-auth-form to download the signed auth form from Google
# Drive and attach it to the ClickUp task (needs Drive read access).
#GOOGLE_SERVICE_ACCOUNT_KEY=/var/app/api/sfe-app-gdrive-integration-1780a21efebe.json
# Optional: user to impersonate (domain-wide delegation) when downloading the auth
# form from Drive — set this only if the forms live in a user's My Drive that the
# service account can't read directly. That user must be able to open the file.
#GOOGLE_DRIVE_SUBJECT=
# SECURITY — SET THIS IN PRODUCTION. Drive folder id the finalised auth forms live in
# (from the folder URL: drive.google.com/drive/folders/<ID>). POST
# /clickup/finalised-auth-form will only download files inside this folder (at any
# depth, so per-client subfolders are fine). Without it, anyone holding
# BREAK_SERVICES_API_KEY can pass ANY Drive file id and have the service account fetch
# whatever it can read. Left unset the restriction is skipped and a warning is logged
# on every download.
#GOOGLE_DRIVE_AUTH_FORM_FOLDER_ID=

# -- Released-report export (Plextrac PDF -> Google Drive) ---------------------
# When a report reaches the released status, it is exported to PDF and filed in
# Drive, and the link is posted in the release announcement's Slack thread.
#
# REQUIRED to switch the feature on: the destination folder id (from the folder
# URL: drive.google.com/drive/folders/<ID>). Left unset, the export is skipped and
# a warning is logged on every release — everything else still runs.
#GOOGLE_DRIVE_REPORTS_FOLDER_ID=1X_sZZSTqE_EQ_lWfYVmN6RGx5x2Y1JNF
#
# Reports are filed under a MONTH FOLDER of that folder, created on first use:
#   <folder>/002. August 2026/Acme Corp - Web App Pentest.pdf
# The month comes from the time of the export. The number prefix makes Drive list the
# months in order instead of alphabetically, and it counts months forward from
# GOOGLE_DRIVE_REPORTS_EPOCH_MONTH below:
#   001. July 2026   002. August 2026   003. September 2026 ...   294. December 2050
# A month folder that already exists is reused (matched on the month name, whatever
# number it carries), so re-releasing never adds a second one.
# Set to false to put every PDF straight in the one folder, unfoldered.
#GOOGLE_DRIVE_REPORTS_MONTH_FOLDERS=true
# Timezone deciding which month an export falls in -- a report released at 00:30 BST
# on the 1st belongs to the new month, which UTC would still call the old one.
#GOOGLE_DRIVE_REPORTS_TZ=Europe/London
# The month numbered 001, as YYYY-MM. Every other number is counted forward from it,
# so a month's number depends ONLY on which month it is -- never on how many folders
# are in Drive. That is what lets old folders be deleted (an 18-month retention sweep,
# an archive tidy-up, or emptying the folder completely) without the count resetting
# or the remaining folders being renumbered. Numbers pass 999 into four digits rather
# than wrapping. Change this only before the first reports are filed: it renumbers
# every future folder, while existing ones keep the numbers already on them.
#GOOGLE_DRIVE_REPORTS_EPOCH_MONTH=2026-07
# Optional extra level INSIDE the month folder, created on first use:
#   <folder>/002. August 2026/Acme Corp/Acme Corp - Web App Pentest.pdf
# Off by default -- the client name is already in the filename.
#GOOGLE_DRIVE_REPORTS_SUBFOLDER_BY_CLIENT=false
#
# The service account (GOOGLE_SERVICE_ACCOUNT_KEY above) needs WRITE access to that
# folder — share the folder with the service account's email as Editor, or set
# GOOGLE_DRIVE_SUBJECT to a user it may impersonate who can write there. Uploads
# request the full https://www.googleapis.com/auth/drive scope; if the key uses
# domain-wide delegation, that scope must be allow-listed for it in Workspace admin.
#
# Export format (pdf or docx; pdf by default).
#PLEXTRAC_EXPORT_FORMAT=pdf
# Plextrac's export endpoint. UNVERIFIED against this instance — run
# `node scripts/inspect-export.js` and set this to whichever candidate returns a real
# PDF. The literal {clientId}, {reportId} and {format} tokens are substituted.
#PLEXTRAC_EXPORT_PATH=/api/v1/client/{clientId}/report/{reportId}/export/{format}
