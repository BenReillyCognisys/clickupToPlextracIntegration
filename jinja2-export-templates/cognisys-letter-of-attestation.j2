{#- ===========================================================================
    Cognisys - Letter of Attestation
    PlexTrac PDF export template (.j2)

    Reproduces "Letter of Attestation - Template - v1.1.docx" as HTML + CSS,
    with its five placeholders filled from the PlexTrac report:

      (CLIENT NAME)            the PlexTrac client's name
      (MONTH YEAR)             the month and year the letter is exported, e.g. "September 2026"
      (LINKS and APP NAMES)    the Scope narrative's in-scope table, printed as PlexTrac
                               holds it (its own table, header row and colours)
      (TOTAL ISSUE COUNT)      number of findings, e.g. "9 issues"
      (INSERT ISSUE COUNT HERE) per-severity breakdown, e.g. "1 Critical, 2 High and 6 Low";
                               severities with no findings are left out

    Anything that cannot be resolved prints its original placeholder in red, so
    a letter never goes out with a silent gap. That includes a report with no
    findings: the counts stay red rather than claiming "no issues".

    Geometry was measured from Word's own PDF rendering of the .docx (see
    README.md), not estimated from the XML alone.

    DO NOT UPLOAD THIS FILE DIRECTLY. Run `python build/build.py` and upload
    dist/cognisys-letter-of-attestation.j2, which has the fonts and logo inlined.
=========================================================================== -#}

{#- =========================== CONFIGURATION =============================== -#}
{#- (LINKS and APP NAMES) - see SCOPE below for how the narrative is read. -#}
{%- set SCOPE_NARRATIVE     = "Scope" -%}           {#- narrative the in-scope hosts are read from -#}
{%- set SCOPE_END           = "The following activities were out of scope for this engagement" -%}   {#- everything from here on is left out -#}
{%- set SCOPE_DROP_LINES    = ["In-Scope", "In Scope"] -%}   {#- a heading starting with one of these ("In-Scope URLs", "In-Scope Subnets", ...) is removed: the letter labels the section "Host(s)" itself -#}
{%- set SCOPE_SKIP_WORDS    = ["authentication", "account", "credential", "password", "username", "login"] -%}   {#- the test accounts never reach the letter: a heading containing one of these words ("User Authentication", "User Accounts") starts a section left out up to the next heading - unless it is an "In-Scope" heading. Set [] to include them. -#}
{%- set SCOPE_SKIP_TABLES   = ["credential", "password", "username", "login"] -%}   {#- a table whose first cell contains one of these ("Credentials | Role") is left out wherever it is, heading or not -#}
{%- set SCOPE_TABLE_HEADERS = true -%}              {#- true = the first row of each scope table is its header row (URL | Notes): always printed, and a table with nothing under it is left out -#}
{%- set SCOPE_DROP_BLANK_ROWS = true -%}            {#- true = table rows left blank in PlexTrac's scope template are not printed -#}
{%- set COUNT_SEVERITIES    = ["Critical", "High", "Medium", "Low", "Informational"] -%}   {#- severities counted, in print order -#}
{%- set NUMBERS_AS_WORDS    = false -%}             {#- true = "nine issues" rather than "9 issues" -#}
{%- set EXCLUDE_FINDING_TITLES = [] -%}             {#- finding titles left out of the counts -#}
{%- set DEBUG_CONTEXT       = false -%}             {#- true = dump the render context on a page before the letter -#}

{#- ===================== CONTEXT GUARDS ===================================
    Same resolution as cognisys-full-report.j2: PlexTrac's PDF pipeline hands
    over lower-case report / client / findings, the Word one upper-case
    REPORT_INFO / CLIENT_INFO / FINDINGS. Accept either.
=========================================================================== -#}
{%- set REPORT_INFO = REPORT_INFO if REPORT_INFO is defined and REPORT_INFO
                 else (report if report is defined and report
                 else (REPORT if REPORT is defined and REPORT else {})) -%}
{%- set CLIENT_INFO = CLIENT_INFO if CLIENT_INFO is defined and CLIENT_INFO
                 else (client if client is defined and client
                 else (CLIENT if CLIENT is defined and CLIENT else {})) -%}
{%- set FINDINGS = FINDINGS if FINDINGS is defined and FINDINGS
              else (findings if findings is defined and findings else []) -%}

{%- set ss = namespace() -%}   {#- strings  -#}
{%- set nn = namespace() -%}   {#- integers -#}

{#- ============================ FIELD LOOKUP ===============================
    Ported from cognisys-full-report.j2 - see there for why three shapes. -#}
{%- macro _key(key) -%}
  {{- (key|default("", true)|string|replace(" ", "_")|replace(")", "")|replace("(", "")|replace("/", "")|replace(":", ""))|lower -}}
{%- endmacro -%}

{#- Leaves the value in ss.value (empty string if not found); prints nothing. -#}
{%- macro _lookup(obj, key) -%}
  {%- set ss.lk = _key(key)|string -%}
  {%- set ss.value = "" -%}
  {%- if obj -%}
    {%- if obj[ss.lk] -%}{%- set ss.value = obj[ss.lk] -%}{%- endif -%}
    {%- if not ss.value and obj.fields is mapping -%}
      {%- if obj.fields[ss.lk] and obj.fields[ss.lk].value -%}
        {%- set ss.value = obj.fields[ss.lk].value -%}
      {%- endif -%}
    {%- endif -%}
    {%- for _bag in [obj.fields, obj.custom_fields, obj.custom_field] -%}
      {%- if not ss.value and _bag and _bag is sequence and _bag is not mapping and _bag is not string -%}
        {%- for _f in _bag -%}
          {%- if not ss.value and _f is mapping and _key(_f.label if _f.label else _f.key)|string == ss.lk -%}
            {%- set ss.value = _f.value if _f.value else (_f.text if _f.text else "") -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if ss.value|string|trim == "None" -%}{%- set ss.value = "" -%}{%- endif -%}
{%- endmacro -%}

{#- The original .docx placeholder, in red, for a value that did not resolve. -#}
{%- macro missing(placeholder) -%}
  <span class="tpl-missing">{{ placeholder|e }}</span>
{%- endmacro -%}

{#- ============================ (CLIENT NAME) ============================== -#}
{{- _lookup(CLIENT_INFO, "name") -}}
{%- set client_name = ss.value|string|trim|e if ss.value|string|trim else missing("(CLIENT NAME)") -%}

{#- ============================ (MONTH YEAR) ===============================
    The month the letter is issued in - the export date, "September 2026".
    Read from REPORT_INFO.export_datetime_us, "MM-DD-YYYY HH:MM" (month first,
    as PlexTrac supplies it; the service sets it to the release time in UK time).
=========================================================================== -#}
{%- set MONTHS = ["January", "February", "March", "April", "May", "June", "July",
                  "August", "September", "October", "November", "December"] -%}
{%- set ss.issued = (REPORT_INFO.export_datetime_us if REPORT_INFO.export_datetime_us
                     else (REPORT_INFO.export_date if REPORT_INFO.export_date else ""))|string|trim -%}
{%- set _issued = ss.issued.split(" ")[0].split("-") -%}
{%- if _issued|length == 3 and _issued[0]|int(0) >= 1 and _issued[0]|int(0) <= 12 and _issued[2]|replace(",", "")|int(0) > 1900 -%}
  {%- set month_year = MONTHS[_issued[0]|int - 1] ~ " " ~ _issued[2]|replace(",", "") -%}
{%- else -%}
  {%- set month_year = missing("(MONTH YEAR)") -%}
{%- endif -%}

{#- ============================== FINDINGS =================================
    Flattened exactly as in cognisys-full-report.j2: a list of groups, a flat
    list, or a dict keyed by id. `is mapping` guards every attribute read -
    iterating a dict yields its string keys, and "key".title is truthy.
=========================================================================== -#}
{%- set report_findings = [] -%}
{%- set _entries = FINDINGS.values()|list if FINDINGS is mapping
             else (FINDINGS|list if FINDINGS and FINDINGS is not string else []) -%}
{%- for _entry in _entries -%}
  {%- set _grp = none -%}
  {%- if _entry is mapping -%}
    {%- set _grp = _entry.FINDINGS if _entry.FINDINGS else (_entry.findings if _entry.findings else none) -%}
  {%- elif _entry is sequence and _entry is not string -%}
    {%- set _grp = _entry -%}
  {%- endif -%}
  {%- if _grp -%}
    {%- for f in (_grp.values()|list if _grp is mapping else _grp) -%}
      {%- if f is mapping and f.title not in EXCLUDE_FINDING_TITLES -%}
        {%- set _ = report_findings.append(f) -%}
      {%- endif -%}
    {%- endfor -%}
  {%- elif _entry is mapping and (_entry.title or _entry.severity or _entry.description) -%}
    {%- if _entry.title not in EXCLUDE_FINDING_TITLES -%}
      {%- set _ = report_findings.append(_entry) -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{#- ================ (TOTAL ISSUE COUNT) / (INSERT ISSUE COUNT HERE) ======== -#}
{%- set NUMBER_WORDS = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten",
  "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen", "twenty"] -%}
{%- macro num(n) -%}
  {%- if NUMBERS_AS_WORDS and n < NUMBER_WORDS|length -%}{{ NUMBER_WORDS[n] }}{%- else -%}{{ n }}{%- endif -%}
{%- endmacro -%}

{#- "Info" is how some PlexTrac instances spell Informational. -#}
{%- set severity_parts = [] -%}
{%- set nn.total = 0 -%}
{%- for sev in COUNT_SEVERITIES -%}
  {%- set nn.c = 0 -%}
  {%- for f in report_findings -%}
    {%- set ss.sev = f.severity|default("", true)|string|lower|trim -%}
    {%- if ss.sev == sev|lower or (sev|lower == "informational" and ss.sev == "info") -%}
      {%- set nn.c = nn.c + 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if nn.c -%}
    {%- set nn.total = nn.total + nn.c -%}
    {%- set _ = severity_parts.append(num(nn.c)|string ~ " " ~ sev|e) -%}
  {%- endif -%}
{%- endfor -%}
{#- "1 Critical, 2 High and 6 Low" - no serial comma, British style. -#}
{%- if severity_parts|length > 1 -%}
  {%- set issue_breakdown = severity_parts[:-1]|join(", ") ~ " and " ~ severity_parts[-1] -%}
{%- else -%}
  {%- set issue_breakdown = severity_parts|join("") -%}
{%- endif -%}
{%- set total_issues = num(nn.total)|string ~ (" issue" if nn.total == 1 else " issues") -%}

{#- ========================= (LINKS and APP NAMES) =========================
    Printed straight from the SCOPE_NARRATIVE narrative - tables, bullets and
    all - as PlexTrac holds it:

      <h5>In-Scope URLs</h5>
      <figure class="table"><table>
        URL | Notes                          <- header row, PlexTrac's fill
        https://app.example.com | Portal     <- one row per host
      </table></figure>
      <h5>User Authentication</h5> <table> Credentials | Role ... </table>
      <p>The following activities were out of scope for this engagement:</p> ...

    The narrative is taken apart into its blocks - headings, paragraphs, lists,
    whole tables - and printed in order, leaving out:
      - everything from SCOPE_END on;
      - the test accounts (SCOPE_SKIP_WORDS): a heading such as "User
        Authentication" and everything under it up to the next heading, and
        any "Credentials | Role" table even without its heading
        (SCOPE_SKIP_TABLES);
      - SCOPE_DROP_LINES headings ("In-Scope URLs": the letter labels the
        section "Host(s)" itself);
      - blocks with no text (the template's empty spacer paragraphs), and with
        SCOPE_DROP_BLANK_ROWS, table rows left blank in the template.
    What is kept is output as PlexTrac's own HTML, inline styles and all; the
    stylesheet only supplies what PlexTrac's editor draws round it (.scope-table).
    A table with no host rows under its header - a scope left unfilled - is
    left out, so an empty scope prints the red placeholder rather than an
    empty table.
=========================================================================== -#}
{%- set ss.scope = "" -%}
{%- set _es = REPORT_INFO.exec_summary if REPORT_INFO.exec_summary
         else (REPORT_INFO.executive_summary if REPORT_INFO.executive_summary else {}) -%}
{%- set _narratives = _es.custom_fields if _es is mapping and _es.custom_fields
                 else (_es if _es is sequence and _es is not mapping and _es is not string else []) -%}
{%- for _f in _narratives if _f is mapping -%}
  {%- set ss.lbl = (_f.label if _f.label else (_f.title if _f.title else ""))|string|trim|lower -%}
  {%- if not ss.scope and ss.lbl in [SCOPE_NARRATIVE|lower, SCOPE_NARRATIVE|lower ~ "s"] -%}
    {%- set ss.scope = (_f.text if _f.text else (_f.value if _f.value else ""))|string -%}
  {%- endif -%}
{%- endfor -%}
{%- set ss.scope = ss.scope.split(SCOPE_END)[0] -%}

{%- set sc = namespace(skipping=false, hit=false, tables=0, text="", table="", rows=0) -%}
{%- set scope_blocks = [] -%}   {#- the HTML printed under "Host(s)", in order -#}

{#- Sets sc.hit when the lower-cased text contains one of the words. -#}
{%- macro _skip_word(text, words) -%}
  {%- set sc.hit = false -%}
  {%- for _w in words if _w|lower in text -%}{%- set sc.hit = true -%}{%- endfor -%}
{%- endmacro -%}

{#- Everything outside tables, one block per heading / paragraph / list. A block
    runs up to and including its closing tag; striptags turns &nbsp; into a
    space and trim removes it, so empty spacer blocks have no text. A heading
    is an <h1>-<h6>, or a short line of text naming the test accounts
    ("User Accounts:") - that starts a skipped section too. -#}
{%- macro _scope_blocks(html) -%}
  {%- set sc.text = html -%}
  {%- for _closer in ["</p>", "</h1>", "</h2>", "</h3>", "</h4>", "</h5>", "</h6>", "</ul>", "</ol>", "</div>", "</blockquote>", "</pre>", "</figure>"] -%}
    {%- set sc.text = sc.text.replace(_closer, _closer ~ "@@SCOPE-BLOCK@@") -%}
  {%- endfor -%}
  {%- for _block in sc.text.split("@@SCOPE-BLOCK@@") -%}
    {%- set ss.key = _block|striptags|trim|lower|replace(":", "")|trim -%}
    {%- set ss.tag = (_block|trim|lower)[:3] -%}
    {%- set ss.list = ss.tag in ["<ul", "<ol"] -%}
    {%- if ss.key -%}
      {%- set ss.drop = false -%}
      {%- if not ss.list and ss.key|length <= 40 -%}
        {%- for _l in SCOPE_DROP_LINES if ss.key.startswith(_l|lower) -%}{%- set ss.drop = true -%}{%- endfor -%}
      {%- endif -%}
      {{- _skip_word(ss.key, SCOPE_SKIP_WORDS) -}}
      {%- set sc.hit = sc.hit and not ss.drop -%}
      {%- if ss.tag in ["<h1", "<h2", "<h3", "<h4", "<h5", "<h6"] -%}
        {%- set sc.skipping = sc.hit -%}
      {%- elif sc.hit and not ss.list and ss.key|length <= 40 -%}
        {%- set sc.skipping = true -%}
      {%- endif -%}
      {%- if not sc.skipping and not ss.drop -%}
        {%- set _ = scope_blocks.append(_block) -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endmacro -%}

{%- set _parts = ss.scope.split("<table") -%}
{{- _scope_blocks(_parts[0]) -}}
{%- for _part in _parts[1:] -%}
  {%- set _split = _part.split("</table>", 1) -%}
  {%- set _rows = _split[0].split("<tr") -%}
  {#- the first cell's text: "URL", "IP Range" - or "Credentials" -#}
  {%- set ss.first = ("<td" ~ (_rows[1] if _rows|length > 1 else "").replace("<th", "<td").split("<td", 1)[-1])|striptags|trim|lower -%}
  {{- _skip_word(ss.first, SCOPE_SKIP_TABLES) -}}
  {%- if not sc.skipping and not sc.hit -%}
    {#- The table as PlexTrac wrote it, minus the rows left blank. -#}
    {%- set sc.table = "<table" ~ _rows[0] -%}
    {%- set sc.rows = 0 -%}
    {%- for _row in _rows[1:] -%}
      {%- set ss.cells = ("<tr" ~ _row)|striptags|trim -%}
      {%- set bb_header = SCOPE_TABLE_HEADERS and loop.first -%}
      {%- if bb_header or ss.cells or not SCOPE_DROP_BLANK_ROWS -%}
        {%- set sc.table = sc.table ~ "<tr" ~ _row -%}
      {%- endif -%}
      {%- if not bb_header and ss.cells -%}
        {%- set sc.rows = sc.rows + 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if sc.rows -%}
      {%- set _ = scope_blocks.append('<div class="scope-table">' ~ sc.table ~ "</table></div>") -%}
      {%- set sc.tables = sc.tables + 1 -%}
    {%- endif -%}
  {%- endif -%}
  {%- if _split|length > 1 -%}{{- _scope_blocks(_split[1]) -}}{%- endif -%}
{%- endfor -%}
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<title>Letter of Attestation</title>
<style>
/* ==========================================================================
   Fonts. Archivo Light is the exact file the .docx embeds (Word renders the
   letter with it); build/build.py rewrites these urls into data: URIs.
   Only the 300 face is declared for "Archivo Light", so bold text is
   synthesised - which is what Word does too: it strokes Archivo Light rather
   than switching to a heavier weight. (The footer's Archivo Medium is drawn
   into data:image/svg+xml;base64,, so it needs no @font-face here.)
   ========================================================================== */
@font-face { font-family: "Archivo Light"; font-style: normal; font-weight: 300; src: url("data:font/woff2;base64,") format("woff2"); }

:root {
  --blue: #3862FF;   /* section headings and "Host(s)" */
  --ink:  #000000;   /* the .docx leaves body text on automatic */

  /* Word sets Archivo on its typo metrics, 878 + 210 per 1000 = 1.088em per
     line - measured at 10.88pt per 10pt line in Word's PDF. */
  --lh: 1.088;
}

/* ==========================================================================
   Page. A4, 72pt side and bottom margins as the .docx. The body starts where
   Word's header ends (header distance 36pt + logo line + three empty 12pt
   Calibri lines), 136.1pt down - not at the nominal 72pt top margin, because
   the header is taller than the margin and Word pushes the body down.
   ========================================================================== */
@page {
  size: A4;
  margin: 136.1pt 72pt 72pt 72pt;

  /* Logo: 78.35 x 47.49pt, flush with the right margin, 44.5pt from the top
     edge. The margin box spans the whole top margin, so the image is placed
     with background-position rather than by sizing the box. */
  @top-right {
    content: ""; width: 78.35pt;
    background: url("data:image/png;base64,") no-repeat;
    background-position: right 0 top 44.5pt;
    background-size: 78.35pt 47.49pt;
  }
  /* Company footer, bottom edge 36pt above the page edge. An SVG because its
     lines mix Archivo Medium and Light - see build/make_letter_footer.py. */
  @bottom-center {
    content: ""; width: 451.28pt;
    background: url("data:image/svg+xml;base64,") no-repeat;
    background-position: center top 11.4pt;
    background-size: 451.28pt 24.6pt;
  }
}

body {
  margin: 0;
  font-family: "Archivo Light", "Archivo", Arial, sans-serif;
  font-weight: 300;
  font-size: 10pt;
  line-height: var(--lh);
  color: var(--ink);
}
p { margin: 0; }

/* Body. Each empty paragraph in the .docx is a spacer with its own font size;
   CSS gives an empty paragraph no height, so each carries one line of it. */
.loa-title { font-size: 12pt; font-weight: bold; text-align: center; }
.loa-h     { font-size: 11pt; color: var(--blue); }
.sp-12     { height: 13.06pt; }   /* empty 12pt line */
.sp-11     { height: 11.97pt; }   /* empty 11pt line */
.sp-10     { height: 10.88pt; }   /* empty 10pt line */

/* Host(s): the Scope narrative's own HTML, printed as PlexTrac holds it. Its
   inline styles are left to apply as written - column widths, row heights,
   padding, header fill, text and border colours - so the table has PlexTrac's
   proportions (1px = 0.75pt, as on screen) rather than the page's full width.
   These rules are the defaults PlexTrac's editor (CKEditor 5) draws with, for
   whatever a cell does not set itself: a 1px grey grid, 0.4em padding, bullets
   indented 40px. The table is left-aligned under "Host(s)"; for CKEditor's
   centred tables, set .scope-table table's margin to "0 auto". As in a browser,
   a column widens past its PlexTrac width for a URL that won't fit it, and the
   URL only breaks at its own hyphens and slashes, or if it outgrows the page. */
.hosts-head { font-size: 9pt; color: var(--blue); min-height: 14.25pt; }
.scope { margin-top: 4pt; }
.scope p, .scope li { margin: 0; }
.scope ul, .scope ol { margin: 0 0 4pt; padding-left: 30pt; }
.scope ul { list-style-type: disc; }
.scope h1, .scope h2, .scope h3, .scope h4, .scope h5, .scope h6 {
  font-size: 10pt; font-weight: bold; margin: 6pt 0 3pt; color: var(--ink);
}
.scope-table { margin: 2pt 0 6pt; }
.scope-table table {
  table-layout: auto; border-collapse: collapse; border-spacing: 0;
  border: 1px double hsl(0, 0%, 70%); max-width: 100%; margin: 0;
}
.scope-table td, .scope-table th {
  border: 1px solid hsl(0, 0%, 75%); padding: 0.4em; min-width: 2em;
  vertical-align: middle; text-align: left; overflow-wrap: break-word;
}
.scope-table th { font-weight: bold; }
.scope-table tr { break-inside: avoid; page-break-inside: avoid; }

/* A placeholder the template could not fill. */
.tpl-missing { color: #B00020; }

/* DEBUG_CONTEXT output only. */
.debug { break-after: page; page-break-after: always; }
.debug pre { font-family: Consolas, monospace; font-size: 7pt; line-height: 1.3; white-space: pre-wrap; word-break: break-all; }
</style>
</head>
<body>

{%- if DEBUG_CONTEXT %}
<section class="debug">
  <p class="loa-h">Template context</p>
  <pre>report keys   {{ (REPORT_INFO.keys()|list if REPORT_INFO is mapping else [])|join(", ")|e }}
client keys   {{ (CLIENT_INFO.keys()|list if CLIENT_INFO is mapping else [])|join(", ")|e }}
issued        {{ ss.issued|e }} -> {{ month_year|striptags|e }}
findings      {{ report_findings|length }} collected: {% for f in report_findings %}{{ f.severity|e }}{{ ", " if not loop.last }}{% endfor %}
scope         {{ scope_blocks|length }} block(s), {{ sc.tables }} table(s){% for b in scope_blocks %}
  {{ b|striptags|truncate(160, true)|e }}{% endfor %}

custom fields:
{% for _bag in [REPORT_INFO.fields, REPORT_INFO.custom_fields, REPORT_INFO.custom_field] if _bag %}{% for _f in (_bag.values()|list if _bag is mapping else _bag) if _f is mapping %}  {{ (_f.label if _f.label else _f.key)|e }} = {{ (_f.value if _f.value else _f.text)|string|truncate(120, true)|e }}
{% endfor %}{% endfor %}</pre>
  <pre>{{ REPORT_INFO|pprint|e|truncate(12000, true, "  ...[truncated]") }}</pre>
</section>
{% endif %}

<p class="loa-title">Letter of Attestation</p>
<p class="sp-12"></p>

<p class="loa-h">Introduction</p>
<p class="sp-10"></p>
<p>Cognisys Group were engaged by {{ client_name }} during {{ month_year }} to identify potential security vulnerabilities that may compromise the confidentiality, integrity, and availability of the {{ client_name }} application.</p>
<p class="sp-10"></p>
<p>Cognisys Group performed this assessment under the guidelines provided in the quote for the engagement and in accordance with testing guidelines. This letter provides a high-level overview of the test performed by the security team and a summary of the results.</p>
<p class="sp-10"></p>

<p class="loa-h">Assessment Scope</p>
<p>Based on the services agreed with {{ client_name }} in the proposal, the following areas were tested during this assessment:</p>
<p class="sp-10"></p>

<p class="hosts-head">Host(s)</p>
{%- if scope_blocks %}
<div class="scope">
{%- for _block in scope_blocks %}
{{ _block }}
{%- endfor %}
</div>
{%- else %}
<p class="scope-missing">{{ missing("(LINKS and APP NAMES)") }}</p>
{%- endif %}
<p class="sp-10"></p>

<p class="loa-h">Summary of the Assessment Results</p>
<p class="sp-10"></p>
